---
import ReviewCard from "../components/ReviewCard.astro";
import type { BusinessConfig } from "../config/types";

interface Props {
  business: BusinessConfig;
}

const { business } = Astro.props;
---

<section class="section reviews" aria-labelledby="reviews-title">
  <div class="shell">
    <div class="review-heading">
      <div>
        <p class="eyebrow">The word around Miami</p>
        <h2 id="reviews-title">A reputation built one chair at a time.</h2>
      </div>
      <div class="rating-summary" aria-label="Five-star client rating">
        <span aria-hidden="true">★★★★★</span>
        <strong>393 reviews · 5.0 average</strong>
      </div>
    </div>
    <div class="review-grid">
      {business.reviews.map((review) => <ReviewCard review={review} />)}
    </div>
    <p class="example-note">Public review excerpts and reputation snapshot.</p>
  </div>
</section>
